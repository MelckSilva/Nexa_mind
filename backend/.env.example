# Exemplo de configuração de ambiente para o backend.
# Substitua os valores abaixo pelas suas credenciais locais.

# Banco de dados PostgreSQL
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/nexamind

# Configuração do Groq
GROQ_API_KEY=seu_groq_api_key_aqui
GROQ_MODEL=openai/gpt-oss-120b

# Modelo de embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ChromaDB
CHROMA_PATH=./ai/data/chroma

# Configurações de chunking e RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RAG_TOP_K=4